  "corrections": [
    {
      "wrong": "コンピニ",
      "correct": "コンビニ",
      "explanation": "「ビ」是濁音，不是半濁音「ピ」。"
    },
    {
      "wrong": "すみません、コンビニはどこですか（問車站時）",
      "correct": "すみません、駅はどこですか",
      "explanation": "車站是「駅」（えき）。"
    },
    {
      "wrong": "お持っていません",
      "correct": "持っていません",
      "explanation": "「お」是尊敬對方用的，講自己的事不加。"
